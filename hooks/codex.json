{
  "description": "Nudges until Apple skill content has been extracted from the local Xcode; asks once for swift-standards and swiftui-specialist before Swift is written",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/check-apple-content.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/skills/swift-standards/scripts/swift-write-check.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
